---
import Footer from '../components/Footer.astro';
import '../styles/global.css';

/**
 * Post-confirmation landing page. Kit's confirmation email redirects here
 * after someone clicks "Save my seat" (set in the Landing page form's
 * Confirmation Email settings → redirect to a URL). Utility page: noindexed
 * and excluded from the sitemap.
 */

const title = 'Seat saved — Souper Greens';
const canonical = new URL(Astro.url.pathname, Astro.site);

// Add profiles as they launch; the row stays hidden while this is empty.
const SOCIALS: Array<{ label: string; href: string; icon?: string }> = [
  { label: 'Follow us on Instagram', href: 'https://www.instagram.com/souper.greens', icon: 'instagram' },
  { label: 'Follow us on TikTok', href: 'https://www.tiktok.com/@souper.greens', icon: 'tiktok' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="canonical" href={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
</head>
<body>

<header class="hero">
  <div class="hero-inner">
    <img class="hero-logo" src="/assets/logo-reverse-tight.svg" alt="Souper Greens" width="412" height="150" />
    <p class="eyebrow">You're confirmed</p>
    <h1>Seat saved.</h1>
    <p class="lead">
      That's everything — your welcome email is already on its way. It comes
      from a real, reply-able inbox, so if you have a question, a request, or a
      strong opinion about soup, just hit reply.
    </p>
    <p class="hero-address">
      <a href="https://www.google.com/maps/search/?api=1&amp;query=301+E+Huntington+Dr%2C+Arcadia%2C+CA+91006" target="_blank" rel="noopener">301 E Huntington Dr, Arcadia, CA 91006</a>
    </p>

    {SOCIALS.length > 0 && (
      <p class="social-row">
        {SOCIALS.map((s) => (
          <a class="btn primary" href={s.href} target="_blank" rel="noopener">
            {s.icon === 'instagram' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
                <rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect>
                <circle cx="12" cy="12" r="4.5"></circle>
                <circle cx="17.6" cy="6.4" r="1.4" fill="currentColor" stroke="none"></circle>
              </svg>
            )}
            {s.icon === 'tiktok' && (
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path>
              </svg>
            )}
            {s.label}
          </a>
        ))}
      </p>
    )}

    <p class="back-home">
      <a href="/">Back to soupergreens.com</a>
    </p>
  </div>
</header>

<Footer />

</body>
</html>
