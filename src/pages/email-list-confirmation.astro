---
import '../styles/global.css';

/**
 * Post-confirmation landing page. Kit's confirmation email redirects here
 * after someone clicks "Save my seat" (set in the Landing page form's
 * Confirmation Email settings → redirect to a URL). Utility page: noindexed
 * and excluded from the sitemap.
 */

const title = 'Seat saved — Souper Greens';
const canonical = new URL(Astro.url.pathname, Astro.site);

// Add profiles as they launch; the row stays hidden while this is empty.
const SOCIALS: Array<{ label: string; href: string; icon?: string }> = [
  { label: 'Follow us on Instagram', href: 'https://www.instagram.com/souper.greens', icon: 'instagram' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="canonical" href={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
</head>
<body>

<header class="hero">
  <div class="hero-inner">
    <img class="hero-logo" src="/assets/logo-reverse-tight.svg" alt="Souper Greens" width="412" height="150" />
    <p class="eyebrow">You're confirmed</p>
    <h1>Seat saved.</h1>
    <p class="lead">
      That's everything — your welcome email is already on its way. It comes
      from a real, reply-able inbox, so if you have a question, a request, or a
      strong opinion about soup, just hit reply.
    </p>
    <p class="hero-address">
      <a href="https://www.google.com/maps/search/?api=1&amp;query=301+E+Huntington+Dr%2C+Arcadia%2C+CA+91006" target="_blank" rel="noopener">301 E Huntington Dr, Arcadia, CA 91006</a>
    </p>

    {SOCIALS.length > 0 && (
      <p class="social-row">
        {SOCIALS.map((s) => (
          <a class="btn primary" href={s.href} target="_blank" rel="noopener">
            {s.icon === 'instagram' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
                <rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect>
                <circle cx="12" cy="12" r="4.5"></circle>
                <circle cx="17.6" cy="6.4" r="1.4" fill="currentColor" stroke="none"></circle>
              </svg>
            )}
            {s.label}
          </a>
        ))}
      </p>
    )}

    <p class="back-home">
      <a href="/">Back to soupergreens.com</a>
    </p>
  </div>
</header>

<footer>
  <div class="foot-brand">
    <img class="foot-logo" src="/assets/logo-primary-tight.svg" alt="Souper Greens" width="412" height="150" />
    <a class="foot-ig" href="https://www.instagram.com/souper.greens" target="_blank" rel="noopener" aria-label="Souper Greens on Instagram">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <defs>
          <radialGradient id="ig-grad" cx="0.3" cy="1.07" r="1.5">
            <stop offset="0" stop-color="#fdf497"></stop>
            <stop offset="0.05" stop-color="#fdf497"></stop>
            <stop offset="0.45" stop-color="#fd5949"></stop>
            <stop offset="0.6" stop-color="#d6249f"></stop>
            <stop offset="0.9" stop-color="#285AEB"></stop>
          </radialGradient>
        </defs>
        <rect width="24" height="24" rx="6" fill="url(#ig-grad)"></rect>
        <rect x="5.2" y="5.2" width="13.6" height="13.6" rx="3.6" fill="none" stroke="#fff" stroke-width="1.7"></rect>
        <circle cx="12" cy="12" r="3.1" fill="none" stroke="#fff" stroke-width="1.7"></circle>
        <circle cx="15.9" cy="8.1" r="1.05" fill="#fff"></circle>
      </svg>
    </a>
  </div>
  <p class="fine">
    <span>a souper. concept</span>
    <span>&copy; 2026 Souper Group LLC. All rights served.</span>
  </p>
</footer>

</body>
</html>
