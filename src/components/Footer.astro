---
/**
 * Shared site footer: brand mark, social links, fine print, legal links.
 * Used by every page — edit here, not per-page.
 */
---
<footer>
  <div class="foot-brand">
    <img class="foot-logo" src="/assets/logo-primary-tight.svg" alt="Souper Greens" width="412" height="150" />
    <span class="foot-social">
      <a class="foot-social-link" href="https://www.instagram.com/souper.greens" target="_blank" rel="noopener" aria-label="Souper Greens on Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <defs>
            <radialGradient id="ig-grad" cx="0.3" cy="1.07" r="1.5">
              <stop offset="0" stop-color="#fdf497"></stop>
              <stop offset="0.05" stop-color="#fdf497"></stop>
              <stop offset="0.45" stop-color="#fd5949"></stop>
              <stop offset="0.6" stop-color="#d6249f"></stop>
              <stop offset="0.9" stop-color="#285AEB"></stop>
            </radialGradient>
          </defs>
          <rect width="24" height="24" rx="6" fill="url(#ig-grad)"></rect>
          <rect x="5.2" y="5.2" width="13.6" height="13.6" rx="3.6" fill="none" stroke="#fff" stroke-width="1.7"></rect>
          <circle cx="12" cy="12" r="3.1" fill="none" stroke="#fff" stroke-width="1.7"></circle>
          <circle cx="15.9" cy="8.1" r="1.05" fill="#fff"></circle>
        </svg>
      </a>
      <a class="foot-social-link" href="https://www.tiktok.com/@souper.greens" target="_blank" rel="noopener" aria-label="Souper Greens on TikTok">
        <!-- Full-colour TikTok note: aqua and red offset copies under the black
             glyph, per the brand mark. viewBox is padded so the offsets don't
             clip at the edges. -->
